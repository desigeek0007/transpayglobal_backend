# Server
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: server-side reCAPTCHA verification (POST /api/). Leave unset to
# have that endpoint return a clear 500 instead of silently "succeeding".
RECAPTCHA_SECRET_KEY=

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only needed for `npm run migrate` (direct Postgres connection to run SQL migrations).
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI, use the
# "Session pooler" or direct connection) and fill in your database password.
# If you skip this, run backend/supabase/migrations/*.sql manually in the Supabase SQL Editor instead.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
